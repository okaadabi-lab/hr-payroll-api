APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8082
APP_TIMEZONE=Asia/Jakarta
LOG_LEVEL=info

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hr_payroll
DB_USERNAME=hr_payroll
DB_PASSWORD=secret

# At least 32 random bytes, e.g. `php -r 'echo bin2hex(random_bytes(32));'`
JWT_SECRET=
JWT_ISSUER=hr-payroll-api
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
