{
    "name": "okasamdya/hr-payroll-api",
    "description": "REST API for attendance, overtime approval and monthly payroll runs under Indonesian rules.",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Oka Samdya Adabi"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "firebase/php-jwt": "^7.2",
        "monolog/monolog": "^3.7",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.14",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "HrPayroll\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HrPayroll\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.3.6"
        }
    },
    "require-dev": {
        "phpstan/phpstan": "^2",
        "phpunit/phpunit": "^11",
        "squizlabs/php_codesniffer": "^3.10",
        "symfony/yaml": "^7"
    },
    "scripts": {
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "php -S 0.0.0.0:8082 -t public"
        ],
        "migrate": "php bin/migrate",
        "seed": "php bin/seed",
        "test": "phpunit",
        "lint": [
            "phpcs",
            "phpstan analyse --memory-limit=1G --no-progress"
        ]
    }
}
